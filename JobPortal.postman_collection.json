		{
			"name": "1. Job Seeker APIs",
			"item": [
				{
					"name": "Register Job Seeker",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Alice Seeker\",\n  \"email\": \"alice.seeker@example.com\",\n  \"password\": \"password123\",\n  \"skills\": [\"JavaScript\", \"Node.js\", \"MongoDB\"],\n  \"experience\": 2,\n  \"education\": \"B.S. Computer Science\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/s-api/register",
							"host": ["{{baseUrl}}"],
							"path": ["s-api", "register"]
						}
					},
					"response": []
				},
				{
					"name": "Login Job Seeker",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"seekerToken\", jsonData.token);",
									"    pm.environment.set(\"token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"alice.seeker@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/s-api/login",
							"host": ["{{baseUrl}}"],
							"path": ["s-api", "login"]
						}
					},
					"response": []
				},
