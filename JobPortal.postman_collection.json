		{
			"name": "4. Security & Authorization Tests",
			"item": [
				{
					"name": "Test Missing Auth Token (Expect 401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 401 Unauthorized\", function () {",
									"    pm.response.to.have.status(401);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/s-api/profile",
							"host": ["{{baseUrl}}"],
							"path": ["s-api", "profile"]
						}
					},
					"response": []
				},
				{
					"name": "Test Role Authorization Mismatch (Seeker creating job - Expect 403)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 403 Forbidden\", function () {",
									"    pm.response.to.have.status(403);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{seekerToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Unauthorized Job Posting\",\n  \"company\": \"Hacker Inc\",\n  \"description\": \"Should fail\",\n  \"location\": \"Remote\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/e-api/create-job",
							"host": ["{{baseUrl}}"],
							"path": ["e-api", "create-job"]
						}
					},
					"response": []
				},
				{
					"name": "Test Duplicate Application (Expect 400)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 400 Bad Request\", function () {",
									"    pm.response.to.have.status(400);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{seekerToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"coverLetter\": \"Trying to apply twice.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/s-api/apply/{{jobId}}",
