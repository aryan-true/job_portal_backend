{
	"info": {
		"_postman_id": "jobportal-backend-api-collection-v1",
		"name": "Job Portal Backend REST API",
		"description": "Complete Postman API Test Collection for Job Portal Backend (Node.js + Express.js + MongoDB).\nIncludes role-based requests for Job Seekers, Employers, and Admins, automatic JWT token management, and security tests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "seekerToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "employerToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "jobId",
			"value": "",
			"type": "string"
		},
		{
			"key": "applicationId",
			"value": "",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "",
			"type": "string"
		}
	],
